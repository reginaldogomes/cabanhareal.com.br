---
import '../styles/global.css';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import bgHero from '@/assets/bg_hero.jpg';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "Cabanha Real | Cordeiro Premium em Tiradentes, Minas Gerais",
  description = "Cortes nobres de cordeiro criados no campo de Tiradentes, MG. Costela, carré, pernil e muito mais, direto do produtor para sua mesa. Peça pelo WhatsApp.",
  image = "/og-image.jpg",
  canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://cabanhareal.com.br").href,
} = Astro.props;

// JSON-LD LocalBusiness — sinal mais forte de SEO local
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FoodEstablishment",
  "name": "Cabanha Real",
  "url": "https://cabanhareal.com.br",
  "logo": "https://cabanhareal.com.br/favicon.svg",
  "image": `https://cabanhareal.com.br${image}`,
  "description": description,
  "telephone": "+55-32-99920-4504",
  "priceRange": "$$",
  "servesCuisine": "Carne de Cordeiro",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Zona Rural – Parque dos Ipês",
    "addressLocality": "Tiradentes",
    "addressRegion": "MG",
    "postalCode": "36325-000",
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "-21.1083",
    "longitude": "-44.1756"
  },
  "areaServed": [
    { "@type": "City", "name": "Tiradentes" },
    { "@type": "City", "name": "São João del-Rei" },
    { "@type": "City", "name": "Prados" },
    { "@type": "City", "name": "Coronel Xavier Chaves" },
    { "@type": "State", "name": "Minas Gerais" }
  ],
  "sameAs": [
    "https://instagram.com/cabanha_real"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+55-32-99920-4504",
    "contactType": "sales",
    "contactOption": "TollFree",
    "availableLanguage": "Portuguese"
  }
};
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Principal -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="keywords" content="cordeiro Tiradentes, carne de cordeiro MG, cabanha cordeiro Minas Gerais, cortes nobres cordeiro, costela cordeiro, carré cordeiro, pernil cordeiro, cabanha real Tiradentes" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content="Cabanha Real" />
    <meta name="theme-color" content="#2d6a4f" />

    <!-- Preload LCP hero image -->
    <link rel="preload" as="image" href={bgHero.src} fetchpriority="high" />
    <!-- DNS prefetch para recursos externos -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://wa.me" />

    <!-- Geo Tags — indexação local -->
    <meta name="geo.region" content="BR-MG" />
    <meta name="geo.placename" content="Tiradentes, Minas Gerais" />
    <meta name="geo.position" content="-21.1083;-44.1756" />
    <meta name="ICBM" content="-21.1083, -44.1756" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`https://cabanhareal.com.br${image}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Cabanha Real" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://cabanhareal.com.br${image}`} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-52X5R6HD');</script>
    <!-- End Google Tag Manager -->
  </head>
  <body class="min-h-screen bg-background text-foreground font-sans antialiased flex flex-col">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-52X5R6HD"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />

    <div
      id="cookie-consent-banner"
      class="fixed inset-x-4 bottom-4 z-50 mx-auto w-auto max-w-xl rounded-xl border border-emerald-200 bg-white/95 p-3 text-sm text-emerald-950 shadow-lg backdrop-blur supports-[backdrop-filter]:bg-white/90"
      role="dialog"
      aria-live="polite"
      aria-label="Consentimento de privacidade e cookies"
      hidden
    >
      <div class="flex items-start gap-3">
        <p class="leading-relaxed">
          Usamos cookies para melhorar sua experiência e medir acessos. Ao continuar no site, você concorda com esse uso.
        </p>
        <button
          id="cookie-consent-accept"
          type="button"
          class="shrink-0 rounded-md bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-emerald-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2"
        >
          Entendi
        </button>
      </div>
    </div>

    <script is:inline>
      (() => {
        const storageKey = 'cabanhareal.cookieConsent.v1';
        const banner = document.getElementById('cookie-consent-banner');
        const acceptButton = document.getElementById('cookie-consent-accept');

        if (!banner || !acceptButton) return;

        try {
          const consentValue = window.localStorage.getItem(storageKey);
          if (consentValue !== 'accepted') banner.hidden = false;

          acceptButton.addEventListener('click', () => {
            window.localStorage.setItem(storageKey, 'accepted');
            banner.hidden = true;
          });
        } catch {
          banner.hidden = false;
        }
      })();
    </script>
  </body>
</html>
