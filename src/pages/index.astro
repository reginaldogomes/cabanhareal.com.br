---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { Benefits } from '../components/Benefits';
import { FeaturedProducts } from '../components/FeaturedProducts';

import About from '../components/About.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import { Menu } from 'lucide-react';
import Lambs from '../components/Lambs.astro';

export const prerender = true;
---

<Layout
  title="Cabanha Real | Cordeiro Premium em Tiradentes, Minas Gerais"
  description="Cortes nobres de cordeiro criados no campo de Tiradentes, MG — costela, carré, pernil, picanha e T-Bone. Direto do produtor para sua mesa. Peça pelo WhatsApp."
  image="/og-image.jpg"
>
  <!-- Header / Nav (Simples para a Landing Page) -->
  <header class="fixed top-0 w-full z-50 bg-background/80 backdrop-blur-md border-b border-border/50">
    <div class="container mx-auto px-4 h-16 md:h-24 flex items-center justify-between">
      <a href="/" class="block">
        <img src="/src/assets/cabanha_real.png" alt="Cabanha Real" class="h-10 md:h-16 w-auto" width="160" height="64" decoding="async" />
      </a>
      
      <nav class="hidden md:flex gap-8 items-center text-sm font-medium text-muted-foreground">
        <a href="#produtos" class="hover:text-primary transition-colors">Produtos</a>
        <a href="#sobre" class="hover:text-primary transition-colors">Sobre Nós</a>
        <a href="https://wa.me/5532999204504" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold text-white transition-colors bg-[#25D366] hover:bg-[#1ebe5d] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366]">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Atendimento
        </a>
      </nav>

      <button type="button" class="md:hidden text-foreground p-2 -mr-2 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" aria-label="Abrir menu de navegação">
        <Menu className="w-6 h-6" aria-hidden="true" />
      </button>
    </div>
  </header>

  <main class="pt-16 md:pt-24"> <!-- offset fixed header height -->
    <Hero />
    <Benefits client:visible />
    <FeaturedProducts client:visible />

    <About />
    
    <div id="contato">
      <FinalCTA />
    </div>
    <Lambs />
  </main>

  <Footer />
</Layout>
