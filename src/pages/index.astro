---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { Benefits } from '../components/Benefits';
import { FeaturedProducts } from '../components/FeaturedProducts';

import About from '../components/About.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import { Menu, MessageCircle } from 'lucide-react';
import Lambs from '../components/Lambs.astro';

export const prerender = true;
---

<Layout>
  <!-- Header / Nav (Simples para a Landing Page) -->
  <header class="fixed top-0 w-full z-50 bg-background/80 backdrop-blur-md border-b border-border/50">
    <div class="container mx-auto px-4 h-20 flex items-center justify-between">
            <a href="/" class="block">
        <img src="/src/assets/cabanha_real.png" alt="Logo Cabanha Real" class="h-12 w-auto" />
      </a>
      
      <nav class="hidden md:flex gap-8 items-center text-sm font-medium text-muted-foreground">
        <a href="#produtos" class="hover:text-primary transition-colors">Produtos</a>
        <a href="#sobre" class="hover:text-primary transition-colors">Sobre Nós</a>
        <a href="https://wa.me/5532999204504" target="_blank" rel="noopener noreferrer" class="bg-primary text-primary-foreground px-5 py-2.5 rounded-md hover:bg-primary/90 transition-all flex items-center gap-2">
          <MessageCircle className="w-4 h-4" />
          Atendimento
        </a>
      </nav>

      <button class="md:hidden text-foreground">
        <Menu className="w-6 h-6" />
      </button>
    </div>
  </header>

  <main class="pt-20"> <!-- pt-20 to offset fixed header -->
    <Hero />
    <Benefits client:visible />
    <FeaturedProducts client:visible />
    

    <About />
    
    <div id="contato">
      <FinalCTA />
    </div>
    <Lambs />
  </main>

  <Footer />
</Layout>
