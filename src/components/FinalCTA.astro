---
import { buttonVariants } from "@/components/ui/button";
---

<section class="w-full bg-[#1A3A3A] py-20">
  <div class="container mx-auto px-4 text-center">
    <div class="max-w-3xl mx-auto space-y-8">
      <h2 class="text-3xl md:text-5xl font-bold text-white tracking-tight">
        Ficou com água na boca?
      </h2>
      <p class="text-xl text-gray-300 font-light px-4">
        Entre em contato conosco pelo WhatsApp e faça seu pedido. Leve a excelência da Cabanha Real para a sua casa.
      </p>
      
      <div class="pt-4">
        <a 
          href="https://wa.me/5532999204504"
          target="_blank"
          rel="noopener noreferrer"
          class={buttonVariants({ size: "lg", className: "bg-teal-600 text-white text-lg py-6 px-10 hover:bg-teal-700 font-medium" })}
        >
          Faça seu Pedido pelo WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
