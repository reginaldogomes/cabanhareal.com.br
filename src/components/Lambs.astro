---
---

<section id="nossos-cordeiros" class="py-24 bg-background">
  <div class="container mx-auto px-4 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">
      Nossos Cordeiros
    </h2>
    <div class="w-20 h-1 bg-primary mx-auto mb-6"></div>
    <p class="text-lg text-muted-foreground max-w-2xl mx-auto mb-12">
      Aqui você pode ver alguns dos nossos cordeiros no pasto da Cabanha.
    </p>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 md:gap-8">
      <div class="rounded-lg overflow-hidden shadow-lg aspect-[4/3] transform hover:scale-105 transition-transform duration-300">
        <img src="/src/assets/cordeiro.jpg" alt="Cordeiros da Cabanha Real pastando em Tiradentes, MG" loading="lazy" decoding="async" width="800" height="600" class="w-full h-full object-cover">
      </div>
      <div class="rounded-lg overflow-hidden shadow-lg aspect-[4/3] transform hover:scale-105 transition-transform duration-300">
        <img src="/src/assets/cordeiro-2.jpg" alt="Rebanho de cordeiros Cabanha Real no campo" loading="lazy" decoding="async" width="800" height="600" class="w-full h-full object-cover">
      </div>
      <div class="rounded-lg overflow-hidden shadow-lg aspect-[4/3] transform hover:scale-105 transition-transform duration-300 sm:col-span-2 md:col-span-1">
        <img src="/src/assets/cordeiro-3.jpg" alt="Cordeiro Cabanha Real criado com bem-estar animal" loading="lazy" decoding="async" width="800" height="600" class="w-full h-full object-cover">
      </div>
    </div>
  </div>
</section>
