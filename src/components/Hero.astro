---
import { buttonVariants } from "@/components/ui/button";
---

<section class="relative h-[80vh] min-h-[600px] w-full flex items-center justify-center overflow-hidden">
  <!-- Imagem de Fundo (Placeholder Lifestyle/Aconchego) -->
  <div class="absolute inset-0 z-0">
    <img
      src="/src/assets/bg_hero.jpg"
      alt="Cabanha Real - Ovelhas no pasto"
      class="w-full h-full object-cover object-center"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-black/40"></div>
  </div>


  <div class="relative z-10 container mx-auto px-4 text-center md:text-left flex flex-col md:flex-row items-center md:justify-start">
    <div class="max-w-2xl text-white space-y-6 animate-in slide-in-from-bottom-8 duration-700 fade-in">
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-white leading-tight">
        Sabor, Tradição e Cuidado do Pasto ao Prato.
      </h1>
      <p class="text-lg md:text-xl text-gray-200 font-light max-w-xl">
        Descubra a excelência em carne de cordeiro, resultado de 7 anos de paixão e dedicação.
      </p>
      <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
        <a href="#produtos" class={buttonVariants({ size: "lg", className: "bg-primary text-primary-foreground hover:bg-primary/90 text-md font-medium" })}>
          Explorar Coleção
        </a>
        <a href="#sobre" class={buttonVariants({ variant: "outline", size: "lg", className: "text-white border-white hover:bg-white hover:text-black text-md font-medium" })}>
          Nossa História
        </a>
      </div>
    </div>
  </div>
</section>
